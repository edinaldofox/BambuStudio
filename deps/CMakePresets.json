{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux dependencies (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/deps-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DEP_DEBUG": "OFF"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 dependencies (Release)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build/deps-windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DEP_DEBUG": "OFF"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 dependencies (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/deps-macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "DEP_DEBUG": "OFF"
      }
    },
    {
      "name": "macos-x86_64-release",
      "displayName": "macOS x86_64 dependencies (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/deps-macos-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "DEP_DEBUG": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "configuration": "Release" },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" },
    { "name": "macos-x86_64-release", "configurePreset": "macos-x86_64-release" }
  ]
}
